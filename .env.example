# Development only. Copy to .env; Django and Compose load this file.
DJANGO_ENV=development
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql://clearance_app:local-development-only@127.0.0.1:55463/clearance
# Set your own value outside local development. Never commit real secrets.
DJANGO_SECRET_KEY=development-only-change-before-any-shared-environment
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
